# Copy to .env and fill in. Never commit .env.

# Required for real translations. Without it the app runs in demo mode (local pseudo-translation).
OPENAI_API_KEY=

# auto (openai when a key is set) | openai | pseudo
LLM_BACKEND=auto

# Cheap model for the bulk, stronger models where quality is decided.
ANALYST_MODEL=gpt-5.4-mini
TRANSLATOR_MODEL=gpt-5.4-mini
JUDGE_MODEL=gpt-5.4
ESCALATION_MODEL=gpt-5.5
REASONING_EFFORT=none
JUDGE_REASONING_EFFORT=low

# Quality loop
QUALITY_THRESHOLD=85
MAX_REFINE_ITERATIONS=2
ENABLE_JUDGE=true
ENABLE_ESCALATION=true

# Throughput and limits
MAX_CONCURRENT_PAGES=4
MAX_UPLOAD_MB=30
MAX_PAGES=60
MIN_FONT_SCALE=0.72
OCR_LANGUAGE=eng

# Send agent traces to the OpenAI dashboard (Traces) in addition to the in-app trace
OPENAI_TRACING=true

# Host port for docker compose
PORT=8000

# Job queue: translations processed at the same time (worker processes)
WORKERS=2

# Admin area (/admin, history) and Prometheus /metrics. Leave empty to disable.
ADMIN_TOKEN=
METRICS_TOKEN=

# MCP server for agents at /mcp and uploads at /api/uploads (bearer token). Leave empty to disable.
MCP_TOKEN=
# Base of the links in MCP results (default: taken from the request)
PUBLIC_URL=
